PORT=8080
HTTP_PORT=8080
GIN_MODE=debug

# Local development database only. Use secrets in production.
POSTGRES_DB=agnos
POSTGRES_USER=agnos
POSTGRES_PASSWORD=agnos
POSTGRES_PORT=5432
DATABASE_URL=postgres://agnos:agnos@localhost:5432/agnos?sslmode=disable

# Replace this value with a strong secret outside local development.
JWT_SECRET=local-development-secret-change-me
JWT_EXPIRY=1h
